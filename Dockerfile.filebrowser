# 第一阶段：从官方镜像提取二进制文件
FROM filebrowser/filebrowser:latest AS binary

# 第二阶段：使用Debian基础镜像并安装中文支持
FROM debian:12-slim

# 安装必要的包和中文locale
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    locales && \
    echo "zh_CN.UTF-8 UTF-8" >> /etc/locale.gen && \
    locale-gen zh_CN.UTF-8 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 设置中文UTF-8环境
ENV LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:zh

# 从第一阶段复制FileBrowser二进制文件和相关脚本
COPY --from=binary /bin/filebrowser /usr/local/bin/filebrowser
COPY --from=binary /init.sh /init.sh
COPY --from=binary /healthcheck.sh /healthcheck.sh

# 创建工作目录
WORKDIR /

# 暴露端口
EXPOSE 80

# 启动FileBrowser
CMD ["/usr/local/bin/filebrowser", "--address", "0.0.0.0", "--port", "80", "--database", "/database/filebrowser.db", "--root", "/srv"]

